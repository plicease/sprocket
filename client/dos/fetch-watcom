#!/bin/sh
#
# Fetch the Open Watcom 2.0 snapshot that the pinned libc16 release was
# built with, for building SPROCKET.EXE reproducibly (as CI and the release
# do). Prints the WATCOM directory on stdout, for `make WATCOM=...`.
#
# The pin is libc16's: this fetches libc16 (fetch-libc16) into build/libc16
# and runs that release's tools/fetch-watcom, which checks the download's
# SHA-256 and reuses an existing unpacked copy.
#
# usage: client/dos/fetch-watcom [DESTDIR]   (default: client/dos/build/tools)

set -eu

here=$(cd "$(dirname "$0")" && pwd)
dest=${1:-"$here/build/tools"}

(cd "$here" && ./fetch-libc16 build/libc16 >&2)
exec sh "$here/build/libc16/tools/fetch-watcom" "$dest"
